# Chyyo-Web Backend 환경 설정
# 복사해서 .env 파일로 사용

# 서버
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chyyo

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# 초기 관리자 비밀번호 (기본 admin 계정 비밀번호 덮어쓰기)
ADMIN_PASSWORD=admin1234

# CORS 허용 오리진 (콤마 구분) — 프론트 로컬 + 도메인
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://panel.choverse.com
